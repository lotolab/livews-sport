{
  "name": "liveui-sport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "lanbery<lanbery@gmail.com>",
  "license": "BSD 3-Clause",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint -c eslint.config.ts \"{src,build,bin}/**/*.{js,mjs,ts,tsx,jsx,vue,json}\"  --fix --cache",
    "lint:css": "stylelint --fix \"src/**/*.{vue,less,css,scss,postcss}\" --cache --cache-location node_modules/.cache/stylelint",
    "format": "prettier \"{src,build,scripts}/**/*.{ts,js,tsx,jsx,json,vue,scss,less}\" --write",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "release": "node ./bin/scripts/dist-zip.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/mdi": "^1.2.3",
    "@unocss/preset-attributify": "^66.5.1",
    "@unocss/preset-icons": "^66.5.1",
    "@unocss/preset-rem-to-px": "^66.5.1",
    "@unocss/preset-typography": "^66.5.1",
    "@unocss/preset-web-fonts": "^66.5.1",
    "@unocss/preset-wind3": "^66.5.1",
    "@unocss/reset": "^66.5.1",
    "@vueuse/core": "^13.9.0",
    "animate.css": "^4.1.1",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "element-plus": "^2.11.2",
    "gsap": "^3.13.0",
    "mitt": "^3.0.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "socket.io-client": "^4.8.1",
    "tiny-emitter": "^2.1.0",
    "unocss": "^66.5.1",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.35.0",
    "@iconify/utils": "^3.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@unocss/vite": "^66.5.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/tsconfig": "^0.7.0",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "chalk": "^5.6.2",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "eslint-plugin-vue": "^10.4.0",
    "fs-extra": "^11.3.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "sass": "^1.89.0",
    "stylelint": "^16.24.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-scss": "^16.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.2",
    "vite-plugin-compression": "^0.5.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "pnpm lint"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}